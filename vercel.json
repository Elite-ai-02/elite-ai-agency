{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://elitetap-review-funnel.onrender.com/api/:path*" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/r/:path*", "destination": "/funnel.html" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/r/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
